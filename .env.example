# Neon: DATABASE_URL is the pooled address (host ends in -pooler), DIRECT_URL the direct one.
# Plain local Postgres: set both to the same address.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/setu_vendor_portal_dev?sslmode=require&pgbouncer=true&connect_timeout=15&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/setu_vendor_portal_dev?sslmode=require&connect_timeout=15"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,write_app_proxy,write_products,read_publications,write_publications,read_merchant_managed_fulfillment_orders,write_metaobjects,write_metaobject_definitions,write_files
SHOPIFY_APP_URL=
# Safety: the app refuses to work with any store not listed here.
ALLOWED_SHOPS=seller-panel-dev.myshopify.com

# Vendor portal (/portal)
# The store whose vendors use the portal. Must also be in ALLOWED_SHOPS.
PORTAL_SHOP=seller-panel-dev.myshopify.com
# Public address of the portal, used in password-reset emails (e.g. https://vendors.setustore.com).
# In development leave empty: the address the request came in on is used.
PORTAL_URL=
# Mail to sellers and to the team, sent through Resend (https://resend.com).
# Leave RESEND_API_KEY empty and nothing is sent: every mail is kept in the
# app's Mail log only, and one-time links are printed in the `npm run dev` output.
RESEND_API_KEY=
# The address mails come from. Its domain must be verified in Resend.
PORTAL_EMAIL_FROM="Setu Store <support@setustore.com>"
# Where a reply to a mail goes.
PORTAL_EMAIL_REPLY_TO=support@setustore.com
# Test list: only these addresses (or whole @domains) really get mail; all
# other mails stay in the log. Separate with commas. Outside production the
# list is REQUIRED for anything to be sent, so a development store can never
# mail real sellers by accident. Leave empty in production once you go live.
MAIL_ONLY_TO=
# Signing secret of the Resend webhook (Resend > Webhooks > your endpoint,
# https://<app address>/webhooks/resend). Lets the log show Delivered / Bounced.
RESEND_WEBHOOK_SECRET=
# Development only: also show would-be emails (e.g. the reset link) on the page.
# Ignored in production. Never set this on a hosted app.
PORTAL_DEV_SHOW_EMAILS=false
