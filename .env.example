DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/setu_vendor_portal_dev"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,read_products,read_metaobjects,read_merchant_managed_fulfillment_orders
SHOPIFY_APP_URL=
# Safety: the app refuses to work with any store not listed here.
ALLOWED_SHOPS=seller-panel-dev.myshopify.com

# Vendor portal (/portal)
# The store whose vendors use the portal. Must also be in ALLOWED_SHOPS.
PORTAL_SHOP=seller-panel-dev.myshopify.com
# Public address of the portal, used in password-reset emails (e.g. https://vendors.setustore.com).
# In development leave empty: the address the request came in on is used.
PORTAL_URL=
# Email for password-reset links (https://resend.com). Leave empty in development:
# emails are then printed in the `npm run dev` output instead.
RESEND_API_KEY=
PORTAL_EMAIL_FROM="Setu Store <vendors@setustore.com>"
# Development only: also show would-be emails (e.g. the reset link) on the page.
# Ignored in production. Never set this on a hosted app.
PORTAL_DEV_SHOW_EMAILS=false
