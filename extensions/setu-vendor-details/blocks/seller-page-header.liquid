{%- render 'setu-seller-page', collection: collection, show_banner: block.settings.show_banner, show_description: block.settings.show_description, show_min: block.settings.show_min, show_rating: block.settings.show_rating, show_facts: block.settings.show_facts, show_times: block.settings.show_times, show_values: block.settings.show_values, show_feedback: block.settings.show_feedback, heading_tag: block.settings.heading_tag -%}
{%- if block.settings.show_description -%}
  <script src="{{ 'setu-about.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Seller page header",
  "target": "section",
  "stylesheet": "setu-vendor.css",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows only on a seller's own collection."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Seller name is",
      "options": [
        {
          "value": "h1",
          "label": "The page's main heading"
        },
        {
          "value": "h2",
          "label": "A sub-heading"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show the seller's banner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show the seller's description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_min",
      "label": "Show minimum order value",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show seller rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_facts",
      "label": "Show city and country, joining date and number of products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_times",
      "label": "Show when an order arrives",
      "info": "Dates worked out from today, the seller's processing time and the delivery time set on the app's Dashboard. Shown only when both are known.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_values",
      "label": "Show the seller's brand values",
      "info": "Up to five short tags each seller picks, such as Women owned or Eco-friendly.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_feedback",
      "label": "Link the rating to the reviews",
      "info": "Use with the Seller reviews block, placed under the product grid.",
      "default": true
    }
  ]
}
{% endschema %}
