{%- comment -%}
  Fills placeholders the theme puts in its pages. Each part is rendered here on
  the server and moved into its placeholder by setu-vendor.js, so there is no
  extra request.

  Product page
    <div class="setu-vendor-header"></div>       logo, name and minimum order value
    <div class="setu-vendor-description"></div>  the vendor's description
  A seller's collection page
    <div class="setu-seller-header"></div>       banner, logo, name, minimum, rating, description
    (added at the top of the page by itself when the setting is on)
  The Brands page
    <div class="setu-all-brands"></div>          every seller with a row of products
    (added to the end of the page content by itself on the page chosen in the settings)
{%- endcomment -%}
{%- if product != blank -%}
  <template id="setu-vendor-header-tpl">
    {%- render 'setu-vendor', part: 'header', product: product, show_tagline: block.settings.show_tagline, show_min: block.settings.show_min, logo_size: block.settings.logo_size, bold_name: block.settings.bold_name -%}
  </template>
  <template id="setu-vendor-description-tpl">
    {%- render 'setu-vendor', part: 'description', product: product, show_link: block.settings.show_link, link_label: block.settings.link_label -%}
  </template>
{%- endif -%}

{%- if request.page_type == 'collection' and collection != blank and block.settings.seller_page != 'off' -%}
  {%- liquid
    assign seller_heading = 'h2'
    if block.settings.seller_hide_title
      assign seller_heading = 'h1'
    endif
  -%}
  {%- if block.settings.seller_feedback -%}
    <script src="{{ 'setu-feedback.js' | asset_url }}" defer></script>
  {%- endif -%}
  <template
    id="setu-seller-header-tpl"
    {% if block.settings.seller_page == 'auto' %}data-auto="top"{% endif %}
    {% if block.settings.seller_hide_title %}data-hide-title="{{ collection.title | escape }}"{% endif %}
  >
    {%- render 'setu-seller-page', collection: collection, show_banner: block.settings.seller_banner, show_description: block.settings.seller_description, show_min: block.settings.show_min, show_rating: block.settings.show_rating, show_facts: block.settings.seller_facts, show_feedback: block.settings.seller_feedback, heading_tag: seller_heading -%}
  </template>
{%- endif -%}

{%- if request.page_type == 'page' and block.settings.brands_handle != blank and page.handle == block.settings.brands_handle -%}
  <script src="{{ 'setu-brands.js' | asset_url }}" defer></script>
  <template id="setu-all-brands-tpl" data-auto="end">
    {%- render 'setu-brands', per_page: block.settings.brands_per_page, product_limit: block.settings.brands_products, show_min: block.settings.show_min, show_rating: block.settings.show_rating, wide: block.settings.brands_wide -%}
  </template>
{%- endif -%}

{% schema %}
{
  "name": "Vendor details",
  "target": "body",
  "javascript": "setu-vendor.js",
  "stylesheet": "setu-vendor.css",
  "enabled_on": {
    "templates": [
      "product",
      "collection",
      "page"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows vendor details wherever the theme has one of these: <div class=\"setu-vendor-header\"></div> and <div class=\"setu-vendor-description\"></div> on product pages, <div class=\"setu-seller-header\"></div> on a seller's collection page, <div class=\"setu-all-brands\"></div> on the Brands page."
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo size",
      "min": 40,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "checkbox",
      "id": "bold_name",
      "label": "Bold brand name",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_tagline",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_min",
      "label": "Show minimum order value",
      "default": true
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Show link to the vendor's products",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "info": "Leave empty for \"Shop all from\" and the vendor's name."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show seller ratings",
      "info": "Stars appear once a seller has reviews.",
      "default": true
    },
    {
      "type": "header",
      "content": "Brands page"
    },
    {
      "type": "text",
      "id": "brands_handle",
      "label": "Brands page handle",
      "info": "The last part of the page's address, e.g. brands for /pages/brands. The list of all sellers shows on this page.",
      "default": "brands"
    },
    {
      "type": "range",
      "id": "brands_per_page",
      "label": "Sellers per page",
      "min": 5,
      "max": 30,
      "step": 5,
      "default": 10
    },
    {
      "type": "range",
      "id": "brands_products",
      "label": "Products shown per seller",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "brands_wide",
      "label": "Use the full page width",
      "info": "Lets the list spread wider than the page's text column, to line up with the page title.",
      "default": true
    },
    {
      "type": "header",
      "content": "Seller's product page"
    },
    {
      "type": "select",
      "id": "seller_page",
      "label": "Seller header on a seller's collection",
      "options": [
        {
          "value": "auto",
          "label": "Add at the top of the page"
        },
        {
          "value": "placeholder",
          "label": "Only where the theme has the placeholder"
        },
        {
          "value": "off",
          "label": "Don't show"
        }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "seller_hide_title",
      "label": "Hide the theme's collection title on seller pages",
      "info": "The seller header already shows the seller's name.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "seller_banner",
      "label": "Show the seller's banner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "seller_description",
      "label": "Show the seller's description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "seller_facts",
      "label": "Show city and country, joining date and number of products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "seller_feedback",
      "label": "Show Feedback (reviews and the review form)",
      "info": "Buyers who have received an order from the seller can rate them. Needs the app to be running.",
      "default": true
    }
  ]
}
{% endschema %}
