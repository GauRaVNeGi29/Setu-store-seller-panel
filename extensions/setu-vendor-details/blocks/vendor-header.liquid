{%- liquid
  assign target_product = block.settings.product | default: product
  render 'setu-vendor', part: 'header', product: target_product, show_min: block.settings.show_min, logo_size: block.settings.logo_size, bold_name: block.settings.bold_name
-%}

{% schema %}
{
  "name": "Vendor header",
  "target": "section",
  "stylesheet": "setu-vendor.css",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo size",
      "min": 40,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "checkbox",
      "id": "bold_name",
      "label": "Bold brand name",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_min",
      "label": "Show minimum order value",
      "default": true
    }
  ]
}
{% endschema %}
