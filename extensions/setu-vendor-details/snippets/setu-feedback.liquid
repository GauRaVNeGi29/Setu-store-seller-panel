{%- doc -%}
  The Feedback block on a seller's page: the seller's reviews, and for a
  signed-in buyer whose order from the seller has shipped, a form to rate the
  seller (and say which item it is about). Hidden until the Feedback button is
  pressed; setu-vendor.js then loads the reviews from the Setu Store Seller
  Panel app through the store's app proxy.

  @param {metaobject} seller - the seller's marketplace_seller entry
  @param {string} name - the seller's name as shown
  @param {string} url - app proxy address of the reviews
  @param {string} [return_url] - where to come back to after signing in
{%- enddoc -%}
<section id="SetuFeedback" class="setu-feedback" data-setu-feedback data-seller="{{ seller.system.handle | escape }}" data-url="{{ url | escape }}" aria-labelledby="SetuFeedbackTitle" tabindex="-1" hidden>
  <h2 class="setu-feedback__title" id="SetuFeedbackTitle">{{ 'setu_vendor.fb_title' | t: name: name | escape }}</h2>
  <p class="setu-feedback__status" data-setu-fb-status role="status">{{ 'setu_vendor.fb_loading' | t }}</p>
  <p class="setu-feedback__summary" data-setu-fb-summary hidden></p>
  <div class="setu-feedback__write" data-setu-fb-write hidden>
    {%- if customer -%}
      <form class="setu-feedback__form" data-setu-fb-form hidden novalidate>
        <h3 class="setu-feedback__form-title" data-setu-fb-form-title>{{ 'setu_vendor.fb_rate' | t }}</h3>
        <p class="setu-feedback__note" data-setu-fb-hidden-note hidden>{{ 'setu_vendor.fb_hidden' | t }}</p>
        <fieldset class="setu-feedback__stars">
          <legend>{{ 'setu_vendor.fb_rating' | t }}</legend>
          <span class="setu-feedback__star-row">
            {%- for i in (1..5) -%}
              <label class="setu-feedback__star">
                <input type="radio" name="rating" value="{{ i }}" required>
                <span aria-hidden="true">★</span>
                <span class="setu-vendor-sr">{{ 'setu_vendor.fb_stars' | t: count: i }}</span>
              </label>
            {%- endfor -%}
          </span>
        </fieldset>
        <label class="setu-feedback__field" data-setu-fb-item-field hidden>
          <span>{{ 'setu_vendor.fb_item' | t }}</span>
          <select name="item" data-setu-fb-item>
            <option value="">{{ 'setu_vendor.fb_item_none' | t }}</option>
          </select>
        </label>
        <label class="setu-feedback__field">
          <span>{{ 'setu_vendor.fb_comment' | t }}</span>
          <textarea name="comment" rows="4" maxlength="1000"></textarea>
        </label>
        <label class="setu-feedback__field">
          <span>{{ 'setu_vendor.fb_name' | t }}</span>
          <input type="text" name="name" maxlength="40" autocomplete="given-name" value="{{ customer.first_name | escape }}">
          <small>{{ 'setu_vendor.fb_name_hint' | t }}</small>
        </label>
        <p class="setu-feedback__error" data-setu-fb-error role="alert" hidden></p>
        <button type="submit" class="setu-feedback__send" data-setu-fb-send>{{ 'setu_vendor.fb_send' | t }}</button>
      </form>
      <p class="setu-feedback__note" data-setu-fb-cannot hidden>{{ 'setu_vendor.fb_cannot' | t }}</p>
      <p class="setu-feedback__note" data-setu-fb-unknown hidden>{{ 'setu_vendor.fb_unknown' | t }}</p>
      <p class="setu-feedback__thanks" data-setu-fb-thanks role="status" hidden>{{ 'setu_vendor.fb_thanks' | t }}</p>
    {%- else -%}
      <p class="setu-feedback__note">
        <a href="{{ routes.account_login_url }}{% if return_url != blank %}?return_to={{ return_url | url_encode }}{% endif %}">{{ 'setu_vendor.fb_sign_in' | t }}</a>
        {{ 'setu_vendor.fb_sign_in_why' | t }}
      </p>
    {%- endif -%}
  </div>

  <ul class="setu-feedback__list" data-setu-fb-list></ul>
  <button type="button" class="setu-feedback__more" data-setu-fb-more hidden>{{ 'setu_vendor.fb_more' | t }}</button>

  <script type="application/json" data-setu-fb-text>
    {
      "none": {{ 'setu_vendor.fb_none' | t | json }},
      "failed": {{ 'setu_vendor.fb_failed' | t | json }},
      "summaryOne": {{ 'setu_vendor.fb_summary_one' | t: rating: '%r' | json }},
      "summary": {{ 'setu_vendor.fb_summary' | t: rating: '%r', count: '%c' | json }},
      "about": {{ 'setu_vendor.fb_about' | t: item: '%i' | json }},
      "edited": {{ 'setu_vendor.fb_edited' | t | json }},
      "stars": {{ 'setu_vendor.fb_out_of' | t: rating: '%r' | json }},
      "change": {{ 'setu_vendor.fb_change' | t | json }},
      "choose": {{ 'setu_vendor.fb_choose' | t | json }},
      "sending": {{ 'setu_vendor.fb_sending' | t | json }}
    }
  </script>
</section>
