// Setu Vendor Portal
//
// Stage 1: a copy of every order line, filed under its vendor, kept in step
// with Shopify by webhooks. Vendors do not log in yet; the team checks the
// data in the embedded admin screen.
//
//   Shopify order ──< VendorOrderLine (one row per line item, carries vendorName)
//
// Shopify stays the source of truth. Every row here can be rebuilt by
// re-reading the order from Shopify (see app/lib/orders/sync.server.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify session storage (from the app template)
// ---------------------------------------------------------------------------
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// Order lines by vendor
// ---------------------------------------------------------------------------

enum LineStatus {
  unfulfilled // nothing shipped yet
  partial // some units shipped
  fulfilled // every remaining unit shipped
  refunded // every unit refunded or removed
  cancelled // the order was cancelled
}

/// One Shopify order line. Vendor = the product's Vendor at the time of the order
/// (Shopify copies it onto the line item, so later product edits don't move it).
model VendorOrderLine {
  shop       String
  lineItemId BigInt // numeric part of gid://shopify/LineItem/…
  orderId    BigInt
  orderName  String // "#1003"

  vendorName   String // "" when the product had no vendor
  productId    BigInt?
  variantId    BigInt?
  title        String
  variantTitle String?
  sku          String?

  quantity          Int // as ordered
  currentQuantity   Int // after refunds, removals and cancellation
  refundedQuantity  Int @default(0)
  fulfilledQuantity Int @default(0)

  currency       String  @default("INR")
  unitPrice      Decimal @db.Decimal(14, 2) // before discounts
  lineTotal      Decimal @db.Decimal(14, 2) // after line + order discounts, before refunds
  refundedAmount Decimal @default(0) @db.Decimal(14, 2)
  netAmount      Decimal @db.Decimal(14, 2) // lineTotal − refundedAmount

  status            LineStatus
  orderCancelled    Boolean    @default(false)
  financialStatus   String // Shopify's display financial status of the whole order
  fulfillmentStatus String // Shopify's display fulfilment status of the whole order
  orderCreatedAt    DateTime
  orderUpdatedAt    DateTime // Shopify's updatedAt at the time we read it
  syncedAt          DateTime   @default(now()) @updatedAt

  @@id([shop, lineItemId])
  @@index([shop, vendorName, orderCreatedAt])
  @@index([shop, orderId])
}

/// One row per shop: when the order history was last fully read.
model SyncState {
  shop              String    @id
  lastFullSyncAt    DateTime?
  lastFullSyncCount Int?
  lastError         String?
  updatedAt         DateTime  @updatedAt
}

/// Every write the app makes to its own data, for tracing problems.
model AuditLog {
  id     BigInt   @id @default(autoincrement())
  shop   String
  at     DateTime @default(now())
  actor  String // "webhook:orders/updated", "admin:email", "backfill"
  action String // "order.synced", "order.removed", "sync.full"
  target String? // "order:19043720364141"
  detail Json?

  @@index([shop, at])
}

// ---------------------------------------------------------------------------
// Vendors and the people who sign in for them
// ---------------------------------------------------------------------------

enum VendorStatus {
  active // its users can sign in and see orders
  paused // nobody from this vendor can sign in; existing sessions end
}

/// A vendor on the portal, tied to one Shopify product Vendor value. A vendor
/// user only ever sees order lines with that exact vendorName.
model Vendor {
  id          String       @id @default(cuid())
  shop        String
  vendorName  String // must equal the Shopify product Vendor, e.g. "Urban Store"
  displayName String // brand name shown in the portal; set by the team
  status      VendorStatus @default(active)

  // Business details – the vendor changes these through a request the team approves
  companyName  String? // registered company name
  addressLine  String?
  city         String?
  state        String?
  postalCode   String?
  gstFileId    String? // VendorFile ids (private documents)
  iecFileId    String?
  adCodeFileId String?

  // Brand details – the vendor changes these directly
  description       String?
  shortDescription  String?
  minimumOrderValue Decimal? @db.Decimal(12, 2) // INR, as given by the vendor; not yet applied to the cart
  logoFileId        String?
  bannerFileId      String?

  // No longer shown (kept so nothing already saved is lost)
  phone       String?
  gstNumber   String?
  policy      String?
  productNote String?

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  users          VendorUser[]
  changeRequests VendorChangeRequest[]
  files          VendorFile[]

  @@unique([shop, vendorName])
}

enum UserStatus {
  invited // team added the email; the person hasn't created a password yet
  pending // signed up on their own; waiting for the team to approve and link a vendor
  active // can sign in and see their vendor's orders
  rejected // sign-up declined by the team
  disabled // "Deactivated": access removed by the team or the vendor's owner
}

enum VendorRole {
  owner // everything, including adding and managing staff
  staff // what their access allows; never manages other people
}

enum StaffAccess {
  view // sees orders and details; changes nothing
  edit // can also edit brand details and send business changes for approval
}

/// A person who signs in. An email is unique per shop. vendorId is set by the
/// team (invite or approval), never by the person.
model VendorUser {
  id           String      @id @default(cuid())
  shop         String
  vendorId     String?
  vendor       Vendor?     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  email        String // lower-case
  name         String?
  phone        String?
  status       UserStatus  @default(invited)
  role         VendorRole  @default(owner)
  access       StaffAccess @default(edit) // used only when role = staff
  invitedById  String? // the owner who added this staff member, if any
  passwordHash String? // scrypt; null until the person sets a password
  /// What a self sign-up submitted (brand name, GST, description, policy, MOV, …), kept for the team's review.
  application  Json?
  reviewedAt   DateTime?
  reviewedBy   String?
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions       PortalSession[]
  resets         PasswordReset[]
  changeRequests VendorChangeRequest[]
  handoffs       PortalHandoff[]

  @@unique([shop, email])
  @@index([shop, status])
}

// ---------------------------------------------------------------------------
// Sign-in security
// ---------------------------------------------------------------------------

/// Every sign-in try, for lockouts and rate limits. Kept for 30 days.
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  shop      String
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([shop, email, createdAt])
  @@index([ip, createdAt])
}

/// "Forgot password" link. Only the token's hash is stored.
model PasswordReset {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  vendorUserId String
  vendorUser   VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)
  ip           String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([vendorUserId])
}

/// Server-side session. The cookie holds a random token; only its hash is stored.
model PortalSession {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  vendorUserId String
  vendorUser   VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  expiresAt    DateTime // absolute limit
  revokedAt    DateTime?
  ip           String?
  userAgent    String?
  /// Set when a Setu Store team member opened the portal "as" this vendor from
  /// Shopify admin: the session is read-only and lasts at most an hour.
  teamViewer   String?

  @@index([vendorUserId])
}

/// One-time link from Shopify admin into a vendor's portal (team view).
/// Only the token's hash is stored; it works once, within 60 seconds.
model PortalHandoff {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  vendorUserId String
  vendorUser   VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)
  teamViewer   String // the team member who opened it, as recorded in the audit log ("admin:<their email>")
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([vendorUserId])
}

// ---------------------------------------------------------------------------
// Business detail changes waiting for the team
// ---------------------------------------------------------------------------

enum ChangeStatus {
  pending
  approved
  rejected
  withdrawn // the vendor cancelled it
}

/// A vendor's request to change business details (name, GST, phone, city,
/// state). Nothing changes on the vendor until the team approves. At most one
/// pending request per vendor; a new one replaces it.
model VendorChangeRequest {
  id            String       @id @default(cuid())
  shop          String
  vendorId      String
  vendor        Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   VendorUser?  @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  /// { field: { from, to } } for the fields that differ, e.g. { "gstNumber": { "from": null, "to": "08ABCDE1234F1Z5" } }
  changes       Json
  status        ChangeStatus @default(pending)
  note          String? // the team's reason, shown to the vendor when declined
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([shop, status])
  @@index([vendorId, createdAt])
}

// ---------------------------------------------------------------------------
// Files vendors upload (documents, logo, banner)
// ---------------------------------------------------------------------------

enum FileKind {
  gst // GST registration certificate
  iec // Import Export Code certificate
  ad_code // AD code letter from the bank
  logo
  banner
}

/// A file a vendor uploaded. Never public: served only to that vendor's own
/// signed-in people and to the Setu Store team. Stored in the database for now.
/// A Vendor's *FileId columns point at the files in use; files attached to a
/// pending business change are referenced from the request until approved.
model VendorFile {
  id           String   @id @default(cuid())
  shop         String
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  kind         FileKind
  fileName     String // as uploaded, cleaned
  mimeType     String // decided from the file's content, not from the browser
  size         Int
  sha256       String
  data         Bytes
  uploadedById String? // VendorUser id, or null when the team uploaded it
  createdAt    DateTime @default(now())

  @@index([vendorId, kind])
}
